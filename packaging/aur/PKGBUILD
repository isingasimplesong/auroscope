# Maintainer: Héphaïstos <hephaistos@ecl.400iso.net>

pkgname=auroscope
pkgver=0.1.0.r20.g04b68b0
pkgrel=1
pkgdesc='LLM-first safety review wrapper around Paru and Pacman'
arch=('x86_64')
url='https://git.2027a.net/2027a/auroscope'
license=('LicenseRef-Unspecified')
depends=(
  'git'
  'glibc'
  'paru'
)
conflicts=(
  'paru<=2.1.0'
)
makedepends=(
  'gcc'
  'go'
)
_commit='04b68b0d9b5a3f965c7b3a935d8130412a6fde3c'
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('5e003c17b4fbbcda65a4300cd4559b1f15533d7612286264ba64111ddd741d8b')

prepare() {
  local installed package_name paru_version

  if installed=$(pacman -Q paru 2>/dev/null); then
    package_name=${installed%% *}
    paru_version=${installed#* }
    if [[ $package_name == paru ]] && (( $(vercmp "$paru_version" '2.1.0') <= 0 )); then
      printf '%s\n' \
        'auroscope: incompatible stable Paru is installed; install paru-git first, then rerun makepkg -si' >&2
      return 1
    fi
  fi

  cd "$srcdir/auroscope"
  mkdir -p build
}

build() {
  cd "$srcdir/auroscope"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOPATH="$srcdir"
  export GOFLAGS='-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw'
  CGO_ENABLED=1 go build -o build/auroscope ./cmd/auroscope
}

check() {
  cd "$srcdir/auroscope"
  CGO_ENABLED=1 go test ./...
}

package() {
  cd "$srcdir/auroscope"
  install -Dm755 build/auroscope "$pkgdir/usr/bin/auroscope"
  install -Dm644 README.md "$pkgdir/usr/share/doc/auroscope/README.md"
}
